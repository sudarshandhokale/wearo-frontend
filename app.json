{
  "expo": {
    "name": "WEARO",
    "slug": "wearo-frontend",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "wearo",
    "icon": "./assets/wearo-logo.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/wearo-logo.png",
        "backgroundColor": "#F7F2EA"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/wearo-logo.png"
    },
    "extra": {
      "apiBaseUrl": ""
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow WEARO to add clothing photos to your wardrobe.",
          "cameraPermission": "Allow WEARO to photograph clothing for your wardrobe."
        }
      ]
    ]
  }
}
